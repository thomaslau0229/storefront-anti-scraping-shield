{
  "name": "storefront-risk-shield",
  "version": "0.1.0",
  "description": "A configurable risk-decision starter kit.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "build": "npm run build:worker",
    "validate:publication": "node scripts/validate-publication.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
