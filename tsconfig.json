{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023", "DOM"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts", "vitest.worker.config.ts"]
}
